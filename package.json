{
  "name": "@forgesworn/qr",
  "version": "0.1.0",
  "description": "QR code encoder and decoder with no dependencies: versions 1-40, all error correction levels, SVG output, camera-frame reading, checked against independent test vectors.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "SPEC.md",
    "llms.txt",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "generate-vectors": "sh scripts/generate-vectors.sh",
    "check": "npm run typecheck && npm test",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "qr",
    "qrcode",
    "qr-code",
    "encoder",
    "svg",
    "zero-dependency"
  ],
  "author": "forgesworn",
  "funding": {
    "type": "lightning",
    "url": "lightning:profusemeat89@walletofsatoshi.com"
  },
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@types/node": "^22",
    "jsqr": "1.4.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://github.com/forgesworn/qr#readme",
  "bugs": {
    "url": "https://github.com/forgesworn/qr/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forgesworn/qr.git"
  }
}
