{
  "name": "@forgesworn/qr",
  "version": "0.3.14",
  "description": "Dependency-free QR code encoder and decoder for TypeScript, browsers, workers and Node, with optional WebAssembly and tracked camera scanning.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./wasm": {
      "types": "./dist/wasm.d.ts",
      "default": "./dist/wasm.js"
    },
    "./qr.wasm": "./dist/qr.wasm"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "SPEC.md",
    "llms.txt",
    "CHANGELOG.md",
    "llms-full.txt",
    "PERFORMANCE.md",
    "SECURITY.md",
    "docs/CHOOSING.md",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "docs/DISTRIBUTION.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-wasm.mjs",
    "test": "vitest run",
    "bench": "npm run build && node scripts/performance.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "generate-vectors": "sh scripts/generate-vectors.sh",
    "fetch-photos": "sh scripts/fetch-photos.sh",
    "photo-sheet": "npm run build && node scripts/photo-sheet.mjs",
    "check": "npm run typecheck && npm test",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check",
    "build:wasm": "node scripts/build-wasm.mjs --write",
    "check:wasm": "node scripts/build-wasm.mjs --check",
    "check:package": "node scripts/check-package.mjs",
    "build:docs": "node scripts/build-docs.mjs",
    "check:docs": "node scripts/build-docs.mjs --check"
  },
  "keywords": [
    "qr",
    "qrcode",
    "qr-code",
    "encoder",
    "decoder",
    "reader",
    "scanner",
    "svg",
    "zero-dependency",
    "wasm",
    "webassembly",
    "camera",
    "barcode",
    "typescript",
    "worker"
  ],
  "author": "forgesworn",
  "funding": {
    "type": "lightning",
    "url": "lightning:profusemeat89@walletofsatoshi.com"
  },
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@types/node": "^22",
    "jsqr": "1.4.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11",
    "marked": "18.2.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://forgesworn.github.io/qr/",
  "bugs": {
    "url": "https://github.com/forgesworn/qr/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forgesworn/qr.git"
  }
}
