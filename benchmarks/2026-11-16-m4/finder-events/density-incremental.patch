+            let actual=if first<=changes.len(){(changes.len()-first)/2+1}else{0};
+            if actual!=count {continue}
+            let density=(0..count.min(32)).filter(|&n|finder_ratio(&window(&changes,data.len(),first+2*n).0,0.8)).count();
+            if density!=target {continue}
+            if let Some(n)=force {if !finder_ratio(&window(&changes,data.len(),first+2*n).0,0.5) {continue}}
+            if let Some(dense)=tail {let hits=(32..count).filter(|&n|finder_ratio(&window(&changes,data.len(),first+2*n).0,0.8)).count();if (dense && hits<16)||(!dense && hits>3){continue}}
+            return data;
+        }
+        panic!("no density fixture count={count} dark_first={dark_first} target={target} force={force:?} tail={tail:?}");
+    }
+    fn check_density_fixture(data: &[u8], count: usize, density: usize, force: Option<usize>, tail: Option<bool>) {
+        let changes:Vec<i32>=(1..data.len()).filter(|&x|data[x]!=data[x-1]).map(|x|x as i32).collect();let first=if data[0]==1 {4}else{5};
+        assert_eq!((changes.len()-first)/2+1,count);
+        assert_eq!((0..count.min(32)).filter(|&n|finder_ratio(&window(&changes,data.len(),first+2*n).0,0.8)).count(),density);
+        if let Some(dense)=tail {let hits=(32..count).filter(|&n|finder_ratio(&window(&changes,data.len(),first+2*n).0,0.8)).count();if dense {assert!(hits>=16)} else {assert!(hits<=3)}}
+        let target_end=force.map(|n|{let (counts,end)=window(&changes,data.len(),first+2*n);assert!(finder_ratio(&counts,0.5));end});
+        let accept=|end:usize|target_end.is_some_and(|target|end==target);
+        let mut old=Vec::new();reference_row(&changes,data.len(),data[0]==1,0.5,|c,end|{let yes=accept(end);old.push((*c,end,yes));yes});
+        if let Some(end)=target_end {assert!(old.iter().any(|entry|entry.1==end && entry.2));}
+        let mut words=vec![0x1234_5678];let mut strict=Vec::new();
+        let direct=scan_joint(&changes,data.len(),first,&mut words,|c,end|{let yes=accept(end);strict.push((*c,end,yes));yes});
+        assert_eq!(direct,count>=32&&density>=16);assert_eq!(words[0],0x1234_5678);if direct {assert_eq!(words.len(),1)}
+        assert_eq!(strict,old);
+        if let Some(n)=force {for skipped in [n+1,n+2] {let end=window(&changes,data.len(),first+2*skipped).1;assert!(!strict.iter().any(|x|x.1==end),"accepted candidate must skip subsequent windows");}let after=n+3;assert!(after<count);let (resumed,end)=window(&changes,data.len(),first+2*after);assert!(finder_ratio(&resumed,0.5));assert!(strict.iter().any(|x|x.1==end),"resume candidate must be checked");}
+        let mut expected=Vec::new();reference_row(&changes,data.len(),data[0]==1,0.8,|c,end|{let yes=accept(end);expected.push((*c,end,yes));yes});
+        for _ in 0..2 {let mut actual=Vec::new();let mut consider=|c: &[i64;5],end|{let yes=accept(end);actual.push((*c,end,yes));yes};if direct {scan_row(&changes,data.len(),data[0]==1,0.8,&mut consider)} else {scan_loose(&changes,data.len(),first,&words[1..],&mut consider)};assert_eq!(actual,expected);}
+    }
