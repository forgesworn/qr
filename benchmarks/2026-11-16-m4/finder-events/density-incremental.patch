+    // Search bounded deterministic run-length fixtures, then assert their
+    // density and schedule explicitly before comparing either path.
+    fn density_fixture(count: usize, dark_first: bool, target: usize, force: Option<usize>, tail: Option<bool>) -> Vec<u8> {
+        let lead = usize::from(!dark_first);
+        let mut seed=0x6132_9d21u32.wrapping_add(count as u32*719).wrapping_add(target as u32*53).wrapping_add(force.unwrap_or(0) as u32*97).wrapping_add(lead as u32);
+        for _ in 0..250_000 {
+            let mut runs=vec![0usize;lead+2*count+3];
+            for r in &mut runs {seed=seed.wrapping_mul(1664525).wrapping_add(1013904223);*r=1+((seed>>16)%3) as usize;}
+            if let Some(ordinal)=force { let base=lead+ordinal*2; runs[base..base+5].copy_from_slice(&[2,2,6,2,2]); let resumed=lead+(ordinal+3)*2; runs[resumed..resumed+5].copy_from_slice(&[2,2,6,2,2]); }
+            if let Some(dense)=tail { for r in runs.iter_mut().skip(lead+67) {*r=if dense {2} else {1};} }
+            let mut data=Vec::new();for (i,n) in runs.into_iter().enumerate(){data.extend(std::iter::repeat_n(((i+lead)%2==0) as u8,n));}
