+fn window(changes: &[i32], width: usize, k: usize) -> ([i64; 5], usize) {
+    let start = k - 4;
+    let a = if start == 0 { 0 } else { changes[start - 1] as usize };
+    let b = changes[start] as usize;
+    let c = changes[start + 1] as usize;
+    let d = changes[start + 2] as usize;
+    let e = changes[start + 3] as usize;
+    let end = if k < changes.len() { changes[k] as usize } else { width };
+    ([(b-a) as i64, (c-b) as i64, (d-c) as i64, (e-d) as i64, (end-e) as i64], end)
+}
+
+// Strict consumes the original schedule immediately. Even windows skipped by a
+// successful strict sighting are classified, for a later loose pass.
+fn scan_joint<F: FnMut(&[i64; 5], usize) -> bool>(changes: &[i32], width: usize, first: usize, words: &mut Vec<u32>, mut consider: F) {
+    let count = if first <= changes.len() { (changes.len() - first) / 2 + 1 } else { 0 };
+    let begin = words.len(); words.resize(begin + (count + 31) / 32, 0);
+    let mut resume = first;
+    for index in 0..count {
+        let k = first + 2 * index;
+        let (counts, end) = window(changes, width, k);
+        let (strict, loose) = joint_ratio(&counts);
+        if loose { words[begin + index / 32] |= 1u32 << (index % 32); }
+        if k >= resume && strict {
+            resume = if consider(&counts, end) { k + 6 } else { k + 2 };
+        }
+    }
+}
+
+// Bits are visited in ascending order. The guard preserves the successful
+// consider skip, even when eligible bits lie inside the skipped interval.
+fn scan_loose<F: FnMut(&[i64; 5], usize) -> bool>(changes: &[i32], width: usize, first: usize, words: &[u32], mut consider: F) {
+    let mut resume = first;
+    for (word_index, &word) in words.iter().enumerate() {
+        let mut bits = word;
+        while bits != 0 {
+            let bit = bits.trailing_zeros() as usize;
+            bits &= bits - 1;
+            let k = first + 2 * (word_index * 32 + bit);
+            if k < resume { continue; }
+            let (counts, end) = window(changes, width, k);
+            resume = if consider(&counts, end) { k + 6 } else { k + 2 };
+        }
+    }
+}
