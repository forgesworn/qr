+    let mut y = skip - 1;
+    while y < height {
+        let changes = edges.row(y);
+        scan_row(changes, width, image.data[y * width] == 1, tolerance, |counts, end| scan.consider(counts, y, end));
+        y += skip;
+    }
+    let mut found = scan.found;
+    found.sort_by(|a, b| b.count.cmp(&a.count));
+    found
