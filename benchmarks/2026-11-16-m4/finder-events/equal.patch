+// One shared error per term. The exact multiplication grouping and term order
+// are those of finder_ratio, and a failed loose term also excludes strict.
+fn joint_ratio(counts: &[i64; 5]) -> (bool, bool) {
+    if counts.iter().any(|&c| c == 0) { return (false, false); }
+    let total: i64 = counts.iter().sum();
+    if total < 7 { return (false, false); }
+    // For five equal positive runs r, total >= 7 implies r >= 2. Their
+    // centre error is 8r/7: above the strict 15r/14 limit and below the
+    // loose 12r/7 limit. The outer errors satisfy both. Each margin is at
+    // least r/14, well above f64 rounding throughout the valid i64 domain.
+    if counts[0] == counts[1] && counts[0] == counts[2] && counts[0] == counts[3] && counts[0] == counts[4] {
+        return (false, true);
+    }
+    let module = total as f64 / 7.0;
+    let strict_slack = module * 0.5;
+    let loose_slack = module * 0.8;
+    let mut strict = true;
+    for (i, &count) in counts.iter().enumerate() {
+        let centre = i == 2;
+        let error = (if centre { 3.0 * module } else { module } - count as f64).abs();
+        let loose = if centre { 3.0 * loose_slack } else { loose_slack };
+        if !(error < loose) { return (false, false); }
+        let narrow = if centre { 3.0 * strict_slack } else { strict_slack };
+        if strict && !(error < narrow) { strict = false; }
+    }
+    (strict, true)
+}
