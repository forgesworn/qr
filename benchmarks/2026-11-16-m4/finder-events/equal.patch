+// Scratch prototype: only the loose eligibility is retained, per image and
+// polarity. A populated empty span is distinct from a row never scanned.
+struct EventSpan { first: usize, begin: usize, end: usize }
+pub(crate) struct FinderEvents { rows: Vec<EventSpan>, words: Vec<u32>, ready: bool }
+impl FinderEvents {
+    pub(crate) fn new() -> Self { Self { rows: Vec::new(), words: Vec::new(), ready: false } }
+}
