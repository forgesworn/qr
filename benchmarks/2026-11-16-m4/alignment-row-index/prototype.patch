+// Scratch prototype: chunks are scoped to one finder triple and one image.
+struct AlignmentChunk { number: usize, first: usize, masks: [u32; 36], overflow: u32 }
+struct AlignmentRow { queried: bool, chunks: Vec<AlignmentChunk> }
+pub(crate) struct AlignmentCache { rows: Vec<AlignmentRow> }
+impl AlignmentCache {
+    pub(crate) fn new() -> Self { Self { rows: Vec::new() } }
+    fn row(&mut self, y: usize) -> &mut AlignmentRow {
+        if self.rows.len() <= y { self.rows.resize_with(y + 1, || AlignmentRow { queried: false, chunks: Vec::new() }); }
+        &mut self.rows[y]
+    }
+}
+fn bucket(lo: usize, hi: usize) -> usize { (lo - 1) * (18 - lo) / 2 + hi - lo }
+fn make_chunk(changes: &[i32], width: usize, number: usize, parity: usize) -> AlignmentChunk {
+    let start = number * 64;
+    let mut k = changes.partition_point(|&x| (x as usize) < start);
+    if k % 2 != parity { k += 1; }
+    let first = k;
+    let mut out = AlignmentChunk { number, first, masks: [0; 36], overflow: 0 };
+    while k + 1 < changes.len() && (changes[k] as usize) < start.saturating_add(64) {
+        let before = changes[k] as i64 - if k == 0 { 0 } else { changes[k - 1] as i64 };
+        let middle = changes[k + 1] as i64 - changes[k] as i64;
+        let end = if k + 2 < changes.len() { changes[k + 2] as i64 } else { width as i64 };
+        let after = end - changes[k + 1] as i64;
+        let lo = before.min(middle).min(after) as usize;
+        let hi = before.max(middle).max(after) as usize;
+        let bit = 1u32 << ((k - first) / 2);
+        if lo > 0 && hi <= 8 { out.masks[bucket(lo, hi)] |= bit; } else { out.overflow |= bit; }
+        k += 2;
+    }
+    out
+}
+// Calls in exactly the original row order. Both edge candidates are always
+// included, since their light runs may be cut by the current window.
+fn alignment_row<F: FnMut(i64, i64, i64, i64)>(changes: &[i32], width: usize, left: i64, right: i64, selected: &[usize], first_pixel_dark: bool, row: &mut AlignmentRow, mut visit: F) {
+    let n = changes.len();
+    let mut k = changes.partition_point(|&x| x as i64 <= left);
+    // The parity of the first light-to-dark boundary depends on left colour.
+    // changes alternate, so parity 0 starts dark iff the first pixel is light.
+    let first_dark_parity = if first_pixel_dark { 1 } else { 0 };
+    if k % 2 != first_dark_parity { k += 1; }
+    if k + 1 >= n || changes[k + 1] as i64 > right { row.queried = true; return; }
+    let first = k;
+    let count_end = changes.partition_point(|&x| x as i64 <= right);
+    let mut last = count_end - 2;
+    if last % 2 != first % 2 { last -= 1; }
+    let scalar = !row.queried;
+    row.queried = true;
+    let emit = |k: usize, visit: &mut F| {
+        let start = if k == 0 { 0 } else { changes[k-1] as i64 }.max(left);
+        let dark_start = changes[k] as i64;
+        let dark_end = changes[k+1] as i64;
+        let end = (if k+2 < n { changes[k+2] as i64 } else { width as i64 }).min(right+1);
+        visit(start, dark_start, dark_end, end);
+    };
+    if scalar {
+        while k <= last { emit(k, &mut visit); k += 2; }
+        return;
+    }
+    for number in (changes[first] as usize / 64)..=(changes[last] as usize / 64) {
+        let pos = match row.chunks.binary_search_by_key(&number, |c| c.number) {
+            Ok(pos) => pos,
+            Err(pos) => { row.chunks.insert(pos, make_chunk(changes, width, number, first%2)); pos }
+        };
+        let chunk = &row.chunks[pos];
+        let mut bits = chunk.overflow;
+        for &index in selected { bits |= chunk.masks[index]; }
+        for edge in [first,last] { if edge >= chunk.first && (edge-chunk.first)%2==0 && (edge-chunk.first)/2<32 && changes[edge] as usize/64==number { bits |= 1 << ((edge-chunk.first)/2); } }
+        while bits != 0 {
+            let b=bits.trailing_zeros() as usize; bits &= bits-1;
+            let candidate=chunk.first+2*b;
+            if candidate >= first && candidate <= last { emit(candidate, &mut visit); }
+        }
+    }
