+#[cfg(test)]
+mod scored_block_tests {
+    use super::*;
+
+    // Independent original scalar predicate, retaining its exact order.
+    fn scalar(scored: &[Scored], p: Point, radius: f64) -> Option<usize> {
+        scored.iter().position(|a| {
+            (a.p.x - p.x).abs() <= radius
+                && (a.p.y - p.y).abs() <= radius
+                && distance(a.p, p) <= radius
+        })
+    }
+
+    #[test]
+    fn groups_match_original_predicate_for_every_prefix() {
+        let mut scored = Vec::new();
+        let mut blocks = Vec::new();
+        let unusual = [0.0, -0.0, 1.0, -1.0, f64::MIN_POSITIVE, f64::MAX, -f64::MAX, f64::INFINITY, f64::NEG_INFINITY, f64::NAN];
+        let radii = [0.0, -0.0, 1.0, 2.0, -1.0, f64::MAX, f64::INFINITY, f64::NEG_INFINITY, f64::NAN];
+        for i in 0..28 {
+            let p = if i < 18 { Point { x: (i * 4) as f64, y: (i % 3) as f64 } }
+                else { Point { x: unusual[i - 18], y: unusual[27 - i] } };
+            // Zero-score points must remain duplicate suppressors.
+            append_scored(&mut scored, &mut blocks, Scored { p, score: if i % 2 == 0 { 0 } else { 22 }, away: 0.0 });
+            assert_eq!(blocks.len(), (scored.len() + 7) / 8);
+            for &x in &unusual {
+                for &y in &unusual {
+                    let query = Point { x, y };
+                    for &radius in &radii {
+                        assert_eq!(scored_duplicate(&scored, &blocks, query, radius), scalar(&scored, query, radius), "prefix {} query {:?} radius {:?}", scored.len(), query, radius);
+                    }
+                }
+            }
+            for j in 0..scored.len() {
+                for radius in [0.0, 1.0, 2.0] {
+                    let query = Point { x: scored[j].p.x + radius, y: scored[j].p.y };
+                    assert_eq!(scored_duplicate(&scored, &blocks, query, radius), scalar(&scored, query, radius));
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn earliest_match_and_inclusive_circle_survive_group_boundaries() {
+        let mut scored = Vec::new();
+        let mut blocks = Vec::new();
+        for i in 0..17 {
+            let p = if i == 7 || i == 8 { Point { x: 0.0, y: 0.0 } }
+                else { Point { x: 100.0 + 10.0 * i as f64, y: 100.0 } };
+            append_scored(&mut scored, &mut blocks, Scored { p, score: 0, away: 0.0 });
+            for query in [Point { x: 3.0, y: 4.0 }, Point { x: 3.0, y: 4.000000000000001 }, Point { x: 5.0, y: 0.0 }, Point { x: 5.000000000000001, y: 0.0 }] {
+                assert_eq!(scored_duplicate(&scored, &blocks, query, 5.0), scalar(&scored, query, 5.0));
+            }
+            if i >= 7 {
+                assert_eq!(scored_duplicate(&scored, &blocks, Point { x: 3.0, y: 4.0 }, 5.0), Some(7));
+                assert_eq!(scored_duplicate(&scored, &blocks, Point { x: 5.0, y: 0.0 }, 5.0), Some(7));
+                assert_eq!(scored_duplicate(&scored, &blocks, Point { x: 5.000000000000001, y: 0.0 }, 5.0), None);
+            }
+        }
+    }
