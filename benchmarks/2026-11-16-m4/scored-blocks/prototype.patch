 pub struct Point {
     pub x: f64,
     pub y: f64,
+}
+
+// Scored points remain in insertion order, including low-scoring suppressors.
+struct Scored {
+    p: Point,
+    score: u32,
+    away: f64,
+}
+
+struct ScoredBlock {
+    min_x: f64,
+    max_x: f64,
+    min_y: f64,
+    max_y: f64,
+    valid: bool,
+}
+
+fn append_scored(scored: &mut Vec<Scored>, blocks: &mut Vec<ScoredBlock>, entry: Scored) {
+    let p = entry.p;
+    let valid = p.x.is_finite() && p.y.is_finite();
+    if scored.len() % 8 == 0 {
+        blocks.push(ScoredBlock { min_x: p.x, max_x: p.x, min_y: p.y, max_y: p.y, valid });
+    } else {
+        let b = blocks.last_mut().unwrap();
+        b.valid = b.valid && valid;
+        b.min_x = b.min_x.min(p.x);
+        b.max_x = b.max_x.max(p.x);
+        b.min_y = b.min_y.min(p.y);
+        b.max_y = b.max_y.max(p.y);
+    }
+    scored.push(entry);
+}
+
+fn scored_duplicate(scored: &[Scored], blocks: &[ScoredBlock], p: Point, radius: f64) -> Option<usize> {
+    let valid_query = radius.is_finite() && radius >= 0.0 && p.x.is_finite() && p.y.is_finite();
+    for (group, b) in blocks.iter().enumerate() {
+        // Each bound uses the original stored-coordinate-minus-query order.
+        // Equality remains eligible; invalid values use the scalar predicate.
+        if valid_query && b.valid && (
+            (b.min_x > p.x && (b.min_x - p.x).abs() > radius) ||
+            (b.max_x < p.x && (b.max_x - p.x).abs() > radius) ||
+            (b.min_y > p.y && (b.min_y - p.y).abs() > radius) ||
+            (b.max_y < p.y && (b.max_y - p.y).abs() > radius)
+        ) { continue; }
+        let start = group * 8;
+        let end = (start + 8).min(scored.len());
+        for i in start..end {
+            let a = &scored[i];
+            if (a.p.x - p.x).abs() <= radius && (a.p.y - p.y).abs() <= radius && distance(a.p, p) <= radius {
+                return Some(i);
+            }
+        }
+    }
+    None
 }
 
