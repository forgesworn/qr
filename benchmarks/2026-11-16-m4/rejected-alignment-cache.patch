+const VERTICAL_SLOTS: usize = 4096;
+const UNKNOWN: i64 = i64::MIN;
+
+#[derive(Clone, Copy)]
+struct VerticalEntry {
+    key: usize,
+    up: i64,
+    down: i64,
+    above: i64,
+    below: i64,
+}
+
+/// Per-triple raw observations. A collision only discards a cached observation.
+#[derive(Default)]
+pub(crate) struct VerticalCache {
+    windows: usize,
+    slots: Vec<VerticalEntry>,
+}
+
+impl VerticalCache {
+    fn begin_window(&mut self) {
+        self.windows += 1;
+        if self.windows == 2 {
+            self.slots = vec![VerticalEntry { key: usize::MAX, up: 0, down: 0, above: UNKNOWN, below: UNKNOWN }; VERTICAL_SLOTS];
+        }
+    }
+}
+
+/// The original bounded vertical walk, with fully observed runs retained for
+/// later windows. No miss scans beyond the current window.
+fn vertical_alignment(image: &BitImage, x: i64, y: i64, top: i64, bottom: i64, tall: f64, slack: f64, cache: &mut VerticalCache) -> f64 {
+    let data = &image.data;
+    let width = image.width as i64;
+    let key = (y * width + x) as usize;
+    let mut slot = if cache.slots.is_empty() { None } else {
+        let hash = (key as u32 ^ ((key as u32) >> 16)).wrapping_mul(0x9e3779b1);
+        let index = ((hash ^ (hash >> 16)) as usize) & (VERTICAL_SLOTS - 1);
+        Some(&mut cache.slots[index])
+    };
+    let hit = slot.as_ref().is_some_and(|entry| entry.key == key);
+    let (up, down) = if hit {
+        let entry = slot.as_ref().unwrap();
+        (entry.up.max(top - 1), entry.down.min(bottom + 1))
+    } else {
+        let mut up = y;
+        while up >= top && data[(up * width + x) as usize] == 1 { up -= 1; }
+        let mut down = y;
+        while down <= bottom && data[(down * width + x) as usize] == 1 { down += 1; }
+        // A boundary at the image edge is complete too. Clipped runs are
+        // deliberately left uncached, so no extra pixels are scanned.
+        if (up >= top || top == 0) && (down <= bottom || bottom == image.height as i64 - 1) {
+            if let Some(entry) = slot.as_deref_mut() {
+                *entry = VerticalEntry { key, up, down, above: UNKNOWN, below: UNKNOWN };
+            }
+        } else {
+            slot = None;
+        }
+        (up, down)
+    };
+    let middle = (down - up - 1) as f64;
+    if !((middle - tall).abs() < slack) { return f64::NAN; }
+
+    let above = if let Some(entry) = slot.as_ref().filter(|entry| entry.above != UNKNOWN) {
+        if up < top { 0 } else { up - entry.above.max(top - 1) }
+    } else {
+        let mut above = 0i64;
+        let mut yy = up;
+        while yy >= top && data[(yy * width + x) as usize] != 1 { above += 1; yy -= 1; }
+        if yy >= top || top == 0 {
+            if let Some(entry) = slot.as_deref_mut() { entry.above = yy; }
+        }
+        above
+    };
+    if !((above as f64 - tall).abs() < slack) { return f64::NAN; }
+
+    let below = if let Some(entry) = slot.as_ref().filter(|entry| entry.below != UNKNOWN) {
+        if down > bottom { 0 } else { entry.below.min(bottom + 1) - down }
+    } else {
+        let mut below = 0i64;
+        let mut yy = down;
+        while yy <= bottom && data[(yy * width + x) as usize] != 1 { below += 1; yy += 1; }
+        if yy <= bottom || bottom == image.height as i64 - 1 {
+            if let Some(entry) = slot.as_deref_mut() { entry.below = yy; }
+        }
+        below
+    };
+    if !((below as f64 - tall).abs() < slack) { return f64::NAN; }
+    (up + 1 + down) as f64 / 2.0
+}
